#!/usr/bin/env bash
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=tool-versions.env disable=SC1091
source "${REPO}/scripts/tool-versions.env"

MODE="developer"
case "${1:-}" in
    --ci) MODE="ci" ;;
    --image) MODE="image" ;;
    "") ;;
    *)
        echo "Usage: $0 [--ci|--image]" >&2
        exit 2
        ;;
esac

TOOLCHAIN_ROOT="${NOVA_TOOLCHAIN_DIR:-${REPO}/.toolchain}"
PRIVILEGE=()
if [[ ${EUID} -ne 0 ]]; then
    PRIVILEGE=(sudo)
fi

CORE_PACKAGES=(
    bc
    bison
    build-essential
    ccache
    "clang-tidy-${CLANG_TIDY_VERSION}"
    cmake
    curl
    device-tree-compiler
    flex
    gcc-aarch64-linux-gnu
    git
    libssl-dev
    ninja-build
    nodejs
    npm
    pipx
    python3
    python3-pexpect
    python3-venv
    python3-yaml
    qemu-system-arm
    shellcheck
    sudo
    wget
    xz-utils
)
DEVELOPER_PACKAGES=(
    gdb-multiarch
    pre-commit
)

install_packages() {
    if ! command -v apt-get >/dev/null 2>&1; then
        echo "apt-get is unavailable; install dependencies manually" >&2
        return
    fi
    local packages=("${CORE_PACKAGES[@]}")
    if [[ "${MODE}" != "ci" ]]; then
        packages+=("${DEVELOPER_PACKAGES[@]}")
    fi
    "${PRIVILEGE[@]}" apt-get update -q
    "${PRIVILEGE[@]}" apt-get install -y --no-install-recommends "${packages[@]}"
    if [[ "${MODE}" == "image" ]]; then
        rm -rf /var/lib/apt/lists/*
    fi
}

pipx_install() {
    if [[ "${MODE}" == "image" ]]; then
        PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin \
            pipx install --force "$1"
    else
        pipx install --force "$1"
    fi
}

install_python_tools() {
    pipx_install "clang-format==${CLANG_FORMAT_VERSION}"
    pipx_install "ruff==${RUFF_VERSION}"
}

verify_sha256() {
    local expected="$1"
    local path="$2"
    local actual
    if command -v sha256sum >/dev/null 2>&1; then
        actual="$(sha256sum "${path}")"
    elif command -v shasum >/dev/null 2>&1; then
        actual="$(shasum -a 256 "${path}")"
    else
        echo "No SHA-256 verifier is available" >&2
        return 1
    fi
    actual="${actual%% *}"
    if [[ "${actual}" != "${expected}" ]]; then
        echo "SHA-256 mismatch for ${path}" >&2
        return 1
    fi
}

install_actionlint() {
    local version="${ACTIONLINT_VERSION#v}"
    local platform
    local architecture
    case "$(uname -s)" in
        Linux) platform="linux" ;;
        Darwin) platform="darwin" ;;
        *)
            echo "Unsupported actionlint platform: $(uname -s)" >&2
            return 1
            ;;
    esac
    case "$(uname -m)" in
        x86_64) architecture="amd64" ;;
        aarch64 | arm64) architecture="arm64" ;;
        *)
            echo "Unsupported actionlint architecture: $(uname -m)" >&2
            return 1
            ;;
    esac

    local archive="actionlint_${version}_${platform}_${architecture}.tar.gz"
    local release="https://github.com/rhysd/actionlint/releases/download/v${version}"
    local temporary
    temporary="$(mktemp -d)"
    curl -fsSLo "${temporary}/${archive}" "${release}/${archive}"
    curl -fsSLo "${temporary}/checksums.txt" \
        "${release}/actionlint_${version}_checksums.txt"
    local expected
    expected="$(awk -v archive="${archive}" '$2 == archive {print $1}' \
        "${temporary}/checksums.txt")"
    if [[ -z "${expected}" ]]; then
        echo "Missing checksum for ${archive}" >&2
        return 1
    fi
    verify_sha256 "${expected}" "${temporary}/${archive}"
    tar -xzf "${temporary}/${archive}" -C "${temporary}" actionlint
    "${PRIVILEGE[@]}" install -m 0755 "${temporary}/actionlint" /usr/local/bin/actionlint
    rm -rf "${temporary}"
}

toolchain_names() {
    local host
    case "$(uname -s):$(uname -m)" in
        Linux:x86_64)
            host="x86_64"
            TOOLCHAIN_SHA256="${ARM_GNU_SHA256_LINUX_X86_64}"
            ;;
        Linux:aarch64 | Linux:arm64)
            host="aarch64"
            TOOLCHAIN_SHA256="${ARM_GNU_SHA256_LINUX_AARCH64}"
            ;;
        Darwin:arm64 | Darwin:aarch64)
            host="darwin-arm64"
            TOOLCHAIN_SHA256="${ARM_GNU_SHA256_DARWIN_ARM64}"
            ;;
        *)
            echo "Unsupported Arm GNU host: $(uname -s) $(uname -m)" >&2
            return 1
            ;;
    esac
    TOOLCHAIN_ARCHIVE="arm-gnu-toolchain-${ARM_GNU_VERSION}-${host}-aarch64-none-elf.tar.xz"
    TOOLCHAIN_EXTRACTED="arm-gnu-toolchain-${ARM_GNU_VERSION,,}-${host}-aarch64-none-elf"
}

install_toolchain() {
    toolchain_names
    local extracted="${TOOLCHAIN_ROOT}/${TOOLCHAIN_EXTRACTED}"
    if [[ ! -d "${extracted}" ]]; then
        local archive="${TOOLCHAIN_ROOT}/${TOOLCHAIN_ARCHIVE}"
        local url="https://developer.arm.com/-/media/Files/downloads/gnu/${ARM_GNU_VERSION}/binrel/${TOOLCHAIN_ARCHIVE}"
        mkdir -p "${TOOLCHAIN_ROOT}"
        curl -fL --retry 3 "${url}" -o "${archive}"
        verify_sha256 "${TOOLCHAIN_SHA256}" "${archive}"
        tar -xf "${archive}" -C "${TOOLCHAIN_ROOT}"
        rm -f "${archive}"
    fi
    ln -sfn "${extracted}" "${TOOLCHAIN_ROOT}/current"
}

version_tuple() {
    python3 - "$1" <<'PY'
import re
import sys

match = re.search(r"\d+(?:\.\d+)+", sys.argv[1])
if match is None:
    raise SystemExit("unable to parse version")
print(match.group())
PY
}

check_qemu() {
    local binary
    binary="$(command -v qemu-system-aarch64 || true)"
    if [[ -z "${binary}" ]]; then
        echo "QEMU ${QEMU_MIN_VERSION}+ is required" >&2
        return 1
    fi
    local installed
    installed="$("${binary}" --version | head -n 1)"
    python3 - "$(version_tuple "${installed}")" "${QEMU_MIN_VERSION}" <<'PY'
import sys

installed = tuple(map(int, sys.argv[1].split(".")))
required = tuple(map(int, sys.argv[2].split(".")))
raise SystemExit(0 if installed >= required else 1)
PY
}

# The distribution's nodejs is the pin: Ubuntu 26.04 carries the Node
# LTS this file names, so the web toolchain needs no third-party archive
# and no second package source. A host that brought its own older Node
# is refused here rather than at the first lint.
check_node() {
    local binary
    binary="$(command -v node || true)"
    if [[ -z "${binary}" ]]; then
        echo "Node ${NODE_VERSION}+ is required for the web toolchain" >&2
        return 1
    fi
    local installed
    installed="$(version_tuple "$("${binary}" --version)")"
    if ((${installed%%.*} < NODE_VERSION)); then
        echo "Node ${NODE_VERSION}+ is required; found ${installed}" >&2
        return 1
    fi
}

write_environment() {
    local environment="${TOOLCHAIN_ROOT}/env.sh"
    mkdir -p "${TOOLCHAIN_ROOT}"
    {
        echo '#!/usr/bin/env bash'
        # shellcheck disable=SC2016
        printf 'export PATH="%s/current/bin:${PATH}"\n' "${TOOLCHAIN_ROOT}"
        echo 'export CROSS_COMPILE="aarch64-none-elf-"'
    } > "${environment}"
    chmod +x "${environment}"
}

install_hooks() {
    if [[ "${MODE}" == "developer" && -d "${REPO}/.git" ]]; then
        (cd "${REPO}" && pre-commit install)
    fi
}

install_packages
"${REPO}/scripts/python-env" "${TOOLCHAIN_ROOT}/python"
install_python_tools
install_actionlint
install_toolchain
check_qemu
check_node
if [[ "${MODE}" != "image" ]]; then
    write_environment
fi
install_hooks
