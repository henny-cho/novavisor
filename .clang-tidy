---
# NovaVisor Clang-Tidy Configuration
# Enforces strictly embedded zero-cost principles by limiting bad OOP structures.
Checks: >-
    -*,
    cppcoreguidelines-*,
    modernize-*,
    performance-*,
    bugprone-*,
    -bugprone-reserved-identifier,
    -bugprone-easily-swappable-parameters,
    -clang-diagnostic-error,
    -cppcoreguidelines-pro-bounds-pointer-arithmetic,
    -cppcoreguidelines-pro-bounds-constant-array-index,
    -cppcoreguidelines-pro-type-reinterpret-cast,
    -cppcoreguidelines-avoid-non-const-global-variables,
    -cppcoreguidelines-avoid-magic-numbers,
    -cppcoreguidelines-missing-std-forward,
    -cppcoreguidelines-owning-memory,
    -cppcoreguidelines-no-malloc,
    -performance-no-int-to-ptr,
    readability-identifier-naming,
    -readability-identifier-length
# Diagnostics only for NovaVisor's own headers — third-party (external/cache,
# toolchain sysroot) is out of scope and would drown real findings.
# NOTE: clang-tidy 19+ ignores HeaderFilterRegex from this file; task.sh lint
# passes the same regex via -header-filter. Keep the two in sync.
WarningsAsErrors: '*'
HeaderFilterRegex: '/src/(components|hal|nova|projects)/'

# Options restricting exception throwing because of -fno-exceptions context.
CheckOptions:
  - key:             cert-err58-cpp.ExceptionsAreAllowed
    value:           '0'
  # --- naming: types ---
  # The cib composition layer is exempt: `<name>_component` registration
  # structs, the `nova_project` component list and its `nova_top` alias
  # mirror the framework's own spelling, so they stay lower_case.
  - key:             readability-identifier-naming.ClassCase
    value:           CamelCase
  - key:             readability-identifier-naming.StructCase
    value:           CamelCase
  - key:             readability-identifier-naming.StructIgnoredRegexp
    value:           '^(nova_project|[a-z0-9_]+_component)$'
  - key:             readability-identifier-naming.UnionCase
    value:           CamelCase
  - key:             readability-identifier-naming.EnumCase
    value:           CamelCase
  - key:             readability-identifier-naming.TypeAliasCase
    value:           CamelCase
  - key:             readability-identifier-naming.TypeAliasIgnoredRegexp
    value:           '^nova_top$'
  - key:             readability-identifier-naming.TypedefCase
    value:           CamelCase
  - key:             readability-identifier-naming.TemplateParameterCase
    value:           CamelCase
  # --- naming: enumerators ---
  - key:             readability-identifier-naming.EnumConstantCase
    value:           CamelCase
  - key:             readability-identifier-naming.EnumConstantPrefix
    value:           'k'
  # --- naming: functions ---
  - key:             readability-identifier-naming.FunctionCase
    value:           lower_case
  - key:             readability-identifier-naming.MethodCase
    value:           lower_case
  # --- naming: variables ---
  - key:             readability-identifier-naming.VariableCase
    value:           lower_case
  - key:             readability-identifier-naming.ParameterCase
    value:           lower_case
  - key:             readability-identifier-naming.PublicMemberCase
    value:           lower_case
  - key:             readability-identifier-naming.ProtectedMemberCase
    value:           lower_case
  - key:             readability-identifier-naming.ProtectedMemberSuffix
    value:           '_'
  - key:             readability-identifier-naming.PrivateMemberCase
    value:           lower_case
  - key:             readability-identifier-naming.PrivateMemberSuffix
    value:           '_'
  - key:             readability-identifier-naming.GlobalVariableCase
    value:           lower_case
  - key:             readability-identifier-naming.GlobalVariablePrefix
    value:           'g_'
  # --- naming: constants ---
  - key:             readability-identifier-naming.GlobalConstantCase
    value:           CamelCase
  - key:             readability-identifier-naming.GlobalConstantPrefix
    value:           'k'
  - key:             readability-identifier-naming.ConstexprVariableCase
    value:           CamelCase
  - key:             readability-identifier-naming.ConstexprVariablePrefix
    value:           'k'
  # cib looks up the `config` member by name, and flow actions /
  # extension points are SCREAMING_CASE per the framework's convention.
  - key:             readability-identifier-naming.ConstexprVariableIgnoredRegexp
    value:           '^(config|[A-Z][A-Z0-9_]+)$'
  - key:             readability-identifier-naming.StaticConstantCase
    value:           CamelCase
  - key:             readability-identifier-naming.StaticConstantPrefix
    value:           'k'
  - key:             readability-identifier-naming.ClassConstantCase
    value:           CamelCase
  - key:             readability-identifier-naming.ClassConstantPrefix
    value:           'k'
  # --- naming: namespaces ---
  - key:             readability-identifier-naming.NamespaceCase
    value:           lower_case
